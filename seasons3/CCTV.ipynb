   "id": "fb9baca3",
   "metadata": {},
   "outputs": [],
   "source": [
    "cap = cv.VideoCapture('rtsp://admin:12345@192.168.1.210:554/Streaming/Channels/101')\n",
    "\n",
    "while True : \n",
    "    ret, frame = cap.read()\n",
    "    cv.imshow('cctv', frame) \n",
    "    if cv.waitKey(1) & 0XFF == 27 : \n",
    "        break\n",
    "cap.release()\n",
    "cv.destroyAllWindows()"
   ]
